---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { compareTalks } from "../scripts/compareTalks.js";
import ScheduleComponent from "@components/ScheduleComponent.astro";

const pageTitle = "Schedule";

const talks = (await getCollection("talks")).sort(compareTalks);
---

<BaseLayout pageTitle={pageTitle}>
  <section class="schedule">
    <div class="container">
      <h2 class="page-header">// {pageTitle}</h2>
      <div class="button-row">
        <!-- TODO: make buttons functional -->
        <button
          class="btn btn--control-tab active"
          type="button"
          data-day="1"
        >
          Day 01
        </button>
        <button
          class="btn btn--control-tab"
          type="button"
          data-day="2"
        >
          Day 02
        </button>
        <button
          class="btn btn--control-tab"
          type="button"
          data-day="3"
        >
          Day 03
        </button>
        <div class="divider divider--vertical"></div>
        <button
          class="btn btn--control-filter"
          type="button"
          data-track="frontend"
        >
          Frontend
        </button>
        <button
          class="btn btn--control-filter"
          type="button"
          data-track="performance"
        >
          Performance
        </button>
        <button
          class="btn btn--control-filter"
          type="button"
          data-track="accessibility"
        >
          A11y
        </button>
        <button
          class="btn btn--control-filter"
          type="button"
          data-track="tooling"
        >
          Tooling
        </button>
        <button
          class="btn btn--control-toggle"
          type="button"
        >
          My Schedule
        </button>
        <button
          class="btn btn--control-clear"
          type="button"
        >
          Clear
        </button>
      </div>
      <div class="divider"></div>
      <ul class="schedule__list">
        {
          talks.map((talk) => (
            <li
              class="schedule__item"
              data-day={talk.data.day}
              data-track={talk.data.track}
            >
              <ScheduleComponent
                talk={talk}
                includeFavoriteButton={true}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  let param_day = "1";
  let param_track = "all";

  function filterTalks() {
    const talks = document.querySelectorAll(".schedule__item");
    talks.forEach((talk) => {
      if (talk instanceof HTMLElement) {
        if (
          talk.dataset.day === param_day &&
          (param_track === "all" || talk.dataset.track === param_track)
        ) {
          talk.classList.remove("hidden");
        } else {
          talk.classList.add("hidden");
        }
      }
    });
  }

  const dayTabButtons = document.querySelectorAll(".btn--control-tab");

  dayTabButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (btn instanceof HTMLElement) {
        param_day = btn.dataset.day || "1";
        filterTalks();
        dayTabButtons.forEach((btn) => btn.classList.remove("active"));
        btn.classList.add("active");
      }
    });
  });

  const filterButtons = document.querySelectorAll(".btn--control-filter");

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (btn instanceof HTMLElement) {
        param_track = btn.dataset.track || "all";
        filterTalks();
        filterButtons.forEach((btn) => btn.classList.remove("active"));
        btn.classList.add("active");
      }
    });
  });
</script>

<style lang="scss">
  .schedule {
    .container {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .button-row {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    &__list {
      display: grid;
      gap: var(--space-sm);
      padding: 0;
    }

    &__item.hidden {
      display: none;
    }
  }
</style>

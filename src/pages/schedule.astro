---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

import ScheduleComponent from "@components/ScheduleComponent.astro";

const pageTitle = "Schedule";

const talks = await getCollection("talks");
---

<BaseLayout pageTitle={pageTitle}>
  <section class="schedule">
    <div class="container">
      <h2 class="page-header">// {pageTitle}</h2>
      <div class="button-row">
        <!-- TODO: make buttons functional -->
        <button
          class="btn btn--control-tab active"
          type="button"
        >
          Day 01
        </button>
        <button
          class="btn btn--control-tab"
          type="button"
        >
          Day 02
        </button>
        <button
          class="btn btn--control-tab"
          type="button"
        >
          Day 03
        </button>
        <div class="divider divider--vertical"></div>
        <button
          class="btn btn--control-filter"
          type="button"
        >
          Frontend
        </button>
        <button
          class="btn btn--control-filter"
          type="button"
        >
          Performance
        </button>
        <button
          class="btn btn--control-filter"
          type="button"
        >
          A11y
        </button>
        <button
          class="btn btn--control-filter"
          type="button"
        >
          Tooling
        </button>
        <button
          class="btn btn--control-toggle"
          type="button"
        >
          My Schedule
        </button>
        <button
          class="btn btn--control-clear"
          type="button"
        >
          Clear
        </button>
      </div>
      <div class="divider"></div>
      <ul class="schedule__list">
        {
          talks.map((talk) => (
            <li class="schedule__item">
              <ScheduleComponent
                talk={talk}
                includeFavoriteButton={true}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .schedule {
    .container {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .button-row {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    &__list {
      display: grid;
      gap: var(--space-sm);
      padding: 0;
    }
  }
</style>
-->


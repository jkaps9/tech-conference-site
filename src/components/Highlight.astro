---
import { Image } from "astro:assets";
import barcodeSvg from "../assets/images/pattern-barcode.svg?raw";
import plusSvg from "../assets/images/icon-plus.svg?raw";
import minusSvg from "../assets/images/icon-minus.svg?raw";

interface Props {
  category: string;
  title: string;
  speakerName: string;
  speakerCompany: string;
  startTime: string;
  endTime: string;
  dayNum: number;
  color: string;
}

const {
  category,
  title,
  speakerName,
  speakerCompany,
  startTime,
  endTime,
  dayNum,
  color,
} = Astro.props;
---

<div class:list={["highlight-card", `bg-${color}`]}>
  <div class="highlight-card__headline">
    <p class=`text-${color}`>{category}</p>
  </div>
  <div class="highlight-card__info">
    <h3>{title}</h3>
    <div class="speaker-details">
      <p class="speaker__name">{speakerName}</p>
      <p class="divider">//</p>
      <p class="speaker__company">{speakerCompany}</p>
    </div>
    <button type="button">
      <div class="open-icon">
        <Fragment set:html={plusSvg} />
      </div>
      <div class="close-icon">
        <Fragment set:html={minusSvg} />
      </div>
      Show Details
    </button>
  </div>
  <div class="highlight-card__footer">
    <div class="times">
      <p class="times__start">{startTime}</p>
      <p class="times__end">{endTime}</p>
    </div>
    <Fragment set:html={barcodeSvg} />
    <p>Day {dayNum}</p>
  </div>
</div>

<style lang="scss">
  .highlight-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-neutral-600);

    &__headline {
      background: var(--color-neutral-900);
      display: flex;
      justify-content: center;
      padding: rem(6) 0;
      text-transform: uppercase;
    }

    &__info {
      padding: var(--space-sm);

      h3 {
        @include type-h2;
        color: var(--color-dark-text);
        margin-bottom: var(--space-xs);
        text-transform: lowercase;
      }

      .speaker-details {
        color: var(--color-medium-text);
        display: flex;
        gap: rem(10);
        text-transform: uppercase;
        margin-bottom: var(--space-sm);

        .speaker__name {
          color: var(--color-dark-text);
          font-weight: 700;
        }
      }

      button {
        @include type-body-xs;
        align-items: center;
        color: var(--color-medium-text);
        display: flex;
        gap: rem(4);
        padding: 0;
        text-transform: uppercase;
        .close-icon {
          display: none;
        }
      }
    }
  }
</style>

---
import { getCollection } from "astro:content";
import SpeakerCard from "./SpeakerCard.astro";

const speakers = await getCollection("speakers");
const featuredSpeakers = speakers.filter((s) => s.data.featured);
---

<section class="featured-speakers">
  <div class="container">
    <h2 class="list-header">// Featured_Speakers</h2>
    <ul class="featured-speakers-list">
      {
        featuredSpeakers.map((speaker) => (
              <li class="featured-speakers-list__item">
                <SpeakerCard
                  image={speaker.data.avatar}
                  altText=`${speaker.data.name} headshot`
                  name=`${speaker.data.name}`
                  description=`${speaker.data.role} @${speaker.data.company}`
                  bgColor=`bg-${speaker.data.color}`
                />
          </li>
        ))
      }
    </ul>

    <div class="button-row">
      <a
        href="speakers/"
        class="btn"
      >
        view all speakers
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  .featured-speakers-list {
    display: grid;
    gap: clamp(1.25rem, 1.0115rem + 1.0178vw, 1.5rem);
    padding: 0;
    position: relative;

    @include bp(md) {
      grid-template-columns: repeat(2, 1fr);
    }

    @include bp(lg) {
      grid-template-columns: repeat(3, 1fr);
    }

    @include bp(xl) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .button-row {
    display: flex;
    justify-content: center;
    margin-top: var(--space-xl);
    width: 100%;
  }
</style>

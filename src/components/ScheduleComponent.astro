---
import { Image } from "astro:assets";
import barcodeSvg from "../assets/images/pattern-barcode.svg?raw";
import plusSvg from "../assets/images/icon-plus.svg?raw";
import minusSvg from "../assets/images/icon-minus.svg?raw";

interface Props {
  category: string;
  title: string;
  description?: string;
  location?: string;
  speakerName: string;
  speakerCompany: string;
  startTime: string;
  endTime: string;
  dayNum: number;
  color: string;
}

const {
  category,
  title,
  description,
  location,
  speakerName,
  speakerCompany,
  startTime,
  endTime,
  dayNum,
  color,
} = Astro.props;
---

<div class:list={["highlight-card", `bg-${color}`]}>
  <div class="highlight-card__headline">
    <p class=`text-${color}`>{category}</p>
  </div>
  <div class="highlight-card__info">
    <h3>{title}</h3>
    <div class="speaker-details">
      <p class="speaker__name">{speakerName}</p>
      <p class="speaker__divider">//</p>
      <p class="speaker__company">{speakerCompany}</p>
    </div>
    <div class="event-details">
      <div class="divider"></div>
      <p>{description}</p>
      <p class="location">{location}</p>
    </div>
    <button
      type="button"
      data-expand-details-button
    >
      <div class="open-icon">
        <Fragment set:html={plusSvg} />
      </div>
      <div class="close-icon">
        <Fragment set:html={minusSvg} />
      </div>
      <span>Show Details</span>
    </button>
  </div>
  <div class="highlight-card__footer">
    <div class="times">
      <p class="times__start">{startTime}</p>
      <p class="times__end">{endTime}</p>
    </div>
    <div class="barcode">
      <Fragment set:html={barcodeSvg} />
    </div>
    <p class="day">Day {dayNum}</p>
  </div>
</div>

<script>
  const infoSections = document.querySelectorAll(".highlight-card__info");

  infoSections.forEach((infoSection) => {
    const btn = infoSection.querySelector("[data-expand-details-button]");
    if (btn) {
      btn.addEventListener("click", () => {
        const txt = btn.querySelector("span");
        if (infoSection.classList.contains("expanded")) {
          infoSection.classList.remove("expanded");
          if (txt) txt.textContent = "Show Details";
        } else {
          infoSection.classList.add("expanded");
          if (txt) txt.textContent = "Hide Details";
        }
      });
    }
  });
</script>

<style lang="scss">
  .highlight-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-neutral-600);

    @include bp(md) {
      flex-direction: row;
    }

    .divider {
      opacity: 0.1;
    }

    &__headline {
      background: var(--color-neutral-900);
      display: flex;
      justify-content: center;
      padding: rem(6) 0;
      text-transform: uppercase;

      @include bp(md) {
        padding: 0 rem(10);
      }

      p {
        @include bp(md) {
          writing-mode: vertical-lr;
          text-align: center;
          transform: rotate(-180deg);
          transform-origin: center;
        }
      }
    }

    &__info {
      padding: var(--space-sm);

      @include bp(md) {
        flex: 1;
        padding: var(--space-md);
      }

      h3 {
        @include type-h2;
        color: var(--color-dark-text);
        margin-bottom: var(--space-xs);
        text-transform: lowercase;
      }

      .speaker-details {
        color: var(--color-medium-text);
        display: flex;
        gap: rem(10);
        text-transform: uppercase;
        margin-bottom: var(--space-sm);

        .speaker__name {
          color: var(--color-dark-text);
          font-weight: 700;
        }
      }

      &.expanded {
        .event-details {
          display: flex;
        }

        button {
          .close-icon {
            display: block;
          }
          .open-icon {
            display: none;
          }
        }
      }

      .event-details {
        display: none;
        flex-direction: column;
        gap: rem(12);
        padding: rem(12) 0;

        p {
          @include type-body-sm;
          color: var(--color-dark-text);
        }

        .location {
          font-weight: 500;
        }
      }

      button {
        @include type-body-xs;
        align-items: center;
        color: var(--color-medium-text);
        display: flex;
        gap: rem(4);
        padding: 0;
        text-transform: uppercase;
        &:hover {
          font-weight: 500;
        }
        .close-icon {
          display: none;
        }
        .open-icon {
          display: block;
        }
      }
    }

    &__footer {
      align-items: center;
      border-top: 2px dashed var(--color-neutral-900);
      color: var(--color-dark-text);
      display: flex;
      gap: var(--space-xs);
      justify-content: space-between;
      padding: var(--space-xs) var(--space-sm);
      text-transform: uppercase;

      @include bp(md) {
        border-left: 2px dashed var(--color-neutral-900);
        border-top: none;
        flex-direction: column;
        justify-content: center;
      }

      .times {
        text-align: center;
        &__start {
          @include type-h4;
          font-family: var(--font-body);
        }
        &__end {
          @include type-body-xs;
        }
      }

      .day {
        @include type-body-xs;
      }
    }
  }
</style>

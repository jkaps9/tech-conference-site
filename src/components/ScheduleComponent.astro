---
import { getEntry } from "astro:content";

import barcodeSvg from "../assets/images/pattern-barcode.svg?raw";
import plusSvg from "../assets/images/icon-plus.svg?raw";
import minusSvg from "../assets/images/icon-minus.svg?raw";
import FavoriteButton from "./FavoriteButton.astro";
import Barcode from "./Barcode.astro";

const { talk, includeFavoriteButton = false, favorite = false } = Astro.props;

const speaker = await getEntry("speakers", talk.data.speaker);
const track = await getEntry("tracks", talk.data.track);
---

<div class:list={["highlight-card", `bg-${track?.data.color}`]}>
  <div class="highlight-card__headline">
    <p class=`text-${track?.data.color}`>{track?.data.name}</p>
  </div>
  <div class="highlight-card__info">
    <h3>{talk.data.title}</h3>
    <div class="speaker-details">
      <p class="speaker__name">{speaker?.data.name}</p>
      <p class="speaker__divider">//</p>
      <p class="speaker__company">{speaker?.data.company}</p>
    </div>
    <div class="event-details">
      <div class="divider"></div>
      <p>{talk.data.description}</p>
      <p class="location">{talk.data.location}</p>
    </div>
    <button
      type="button"
      data-expand-details-button
    >
      <span class="open-icon">
        <Fragment set:html={plusSvg} />
      </span>
      <span class="close-icon">
        <Fragment set:html={minusSvg} />
      </span>
      <span>Show Details</span>
    </button>
  </div>
  <div class="highlight-card__footer">
    <div class="times">
      <p class="times__start">{talk.data.startTime}</p>
      <p class="times__end">{talk.data.endTime}</p>
    </div>
    <div class="barcode">
      <Barcode id={talk.data.id} />
    </div>

    {!includeFavoriteButton && <p class="day">Day {talk.data.day}</p>}
    {includeFavoriteButton && <FavoriteButton isFavorite={favorite} />}
  </div>
</div>
<script>
  const infoSections = document.querySelectorAll(".highlight-card__info");

  infoSections?.forEach((infoSection) => {
    const btn = infoSection.querySelector("[data-expand-details-button]");
    if (btn) {
      btn.addEventListener("click", () => {
        const txt = btn.querySelector("span");
        if (infoSection.classList.contains("expanded")) {
          infoSection.classList.remove("expanded");
          if (txt) txt.textContent = "Show Details";
        } else {
          infoSection.classList.add("expanded");
          if (txt) txt.textContent = "Hide Details";
        }
      });
    }
  });
</script>

<style lang="scss">
  .highlight-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-neutral-600);

    @include bp(md) {
      flex-direction: row;
    }

    .divider {
      opacity: 0.1;
    }

    &__headline {
      background: var(--color-neutral-900);
      display: flex;
      justify-content: center;
      padding: rem(6) 0;
      text-transform: uppercase;

      @include bp(md) {
        padding: 0 rem(10);
      }

      p {
        @include bp(md) {
          writing-mode: vertical-lr;
          text-align: center;
          transform: rotate(-180deg);
          transform-origin: center;
        }
      }
    }

    &__info {
      padding: var(--space-sm);

      @include bp(md) {
        flex: 1;
        padding: var(--space-md);
      }

      h3 {
        @include type-h2;
        color: var(--color-dark-text);
        margin-bottom: var(--space-xs);
        text-transform: lowercase;
      }

      .speaker-details {
        color: var(--color-medium-text);
        display: flex;
        gap: rem(10);
        text-transform: uppercase;
        margin-bottom: var(--space-sm);

        .speaker__name {
          color: var(--color-dark-text);
          font-weight: 700;
        }
      }

      &.expanded {
        .event-details {
          display: flex;
        }

        button {
          .close-icon {
            display: block;
          }
          .open-icon {
            display: none;
          }
        }
      }

      .event-details {
        display: none;
        flex-direction: column;
        gap: rem(12);
        padding: rem(12) 0;

        p {
          @include type-body-sm;
          color: var(--color-dark-text);
        }

        .location {
          font-weight: 500;
        }
      }

      button {
        @include type-body-xs;
        align-items: center;
        color: var(--color-medium-text);
        display: flex;
        gap: rem(4);
        padding: 0;
        text-transform: uppercase;
        &:hover {
          font-weight: 500;
        }
        .close-icon {
          display: none;
        }
        .open-icon {
          display: block;
        }
      }
    }

    &__footer {
      align-items: center;
      border-top: 2px dashed var(--color-neutral-900);
      color: var(--color-dark-text);
      display: flex;
      gap: var(--space-xs);
      justify-content: space-between;
      padding: var(--space-xs) var(--space-sm);
      text-transform: uppercase;

      @include bp(md) {
        border-left: 2px dashed var(--color-neutral-900);
        border-top: none;
        flex-direction: column;
      }

      .times {
        text-align: center;
        &__start {
          @include type-h4;
          font-family: var(--font-body);
        }
        &__end {
          @include type-body-xs;
        }
      }

      .day {
        @include type-body-xs;
      }
    }
  }
</style>

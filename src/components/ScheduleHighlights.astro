---
import { getCollection } from "astro:content";
import ScheduleComponent from "./ScheduleComponent.astro";

const talks = await getCollection("talks");
const highlightedTalks = talks.filter((t) => t.data.highlighted);
---

<section class="schedule-highlights">
  <div class="container">
    <h2 class="list-header">// Schedule_Highlights</h2>
    <ul class="schedule-highlights__list">
      {
        highlightedTalks.map((talk) => (
          <li class="schedule-highlights__item">
            <ScheduleComponent talk={talk} />
          </li>
        ))
      }
    </ul>
    <div class="button-row">
      <a
        href="schedule/"
        class="btn"
      >
        view full schedule
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  .schedule-highlights {
    &__list {
      display: grid;
      gap: var(--space-sm);
      padding: 0;
    }
  }
  .button-row {
    display: flex;
    justify-content: center;
    margin-top: var(--space-xl);
    width: 100%;
  }
</style>

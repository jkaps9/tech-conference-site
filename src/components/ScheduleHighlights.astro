---
import Highlight from "./Highlight.astro";
---

<section class="schedule-highlights">
  <div class="section">
    <h2 class="list-header">// Schedule_Highlights</h2>
    <ul class="schedule-highlights__list">
      <li class="schedule-highlights__item">
        <Highlight
          category="Performance"
          title="Video Compression for the Web: The Middle-Out Approach"
          speakerName="Dinesh Chugtai"
          speakerCompany="Pied Piper"
          startTime="11:00"
          endTime="12:00"
          dayNum={1}
          color="red"
        />
      </li>
    </ul>
    <div class="button-row">
      <a
        href="tech-conference-site/speakers/"
        class="btn"
      >
        view full schedule
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  .button-row {
    display: flex;
    justify-content: center;
    margin-top: var(--space-xl);
    width: 100%;
  }
</style>

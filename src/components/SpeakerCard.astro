---
import { Image } from "astro:assets";

interface Props {
  imagePath: string;
  altText: string;
  name: string;
  description: string;
  talkTitle: string;
}

const { imagePath, altText, name, description, talkTitle } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{jpeg,jpg,png,gif,webp}",
);
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/images/*.{jpeg,jpg,png,gif,webp}"`,
  );
---

<div class="speaker-card">
  <div class="speaker-card__image">
    <Image
      src={images[imagePath]()}
      alt={altText}
    />
  </div>
  <div class="speaker-card__bottom">
    <div class="speaker">
      <h3 class="speaker__name">{name}</h3>
      <p class="speaker__description">{description}</p>
    </div>
    <div class="divider"></div>
    <p class="talk-title">{talkTitle}</p>
  </div>
</div>

<style lang="scss">
  .speaker-card {
    background: var(--color-neutral-800);
    border: 1px solid var(--color-neutral-600);
    display: flex;
    flex-direction: column;
    height: stretch;

    &__image {
      img {
        height: auto;
      }
    }

    &__bottom {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      height: stretch;
      padding: var(--space-sm);
    }

    .divider {
      background: var(--color-neutral-600);
      height: 1px;
    }

    .speaker {
      isplay: flex;
      flex-direction: column;
      gap: 0.25rem;
      height: stretch;

      &__name {
        color: var(--color-neutral-100);
        text-transform: lowercase;
      }

      &__description {
        @include type-body-sm;
        font-weight: 500;
      }
    }

    .talk-title {
      @include type-body-sm;
      color: var(--color-green-200);
      font-weight: 500;
      text-transform: uppercase;
    }
  }
</style>

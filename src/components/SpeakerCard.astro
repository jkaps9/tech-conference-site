---
import { Image } from "astro:assets";

interface Props {
  imagePath: string;
  altText: string;
  name: string;
  description: string;
  talkTitle: string;
}

const { imagePath, altText, name, description, talkTitle } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{jpeg,jpg,png,gif,webp}",
);
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/images/*.{jpeg,jpg,png,gif,webp}"`,
  );
---

<div class="speaker-card">
  <div class="speaker-card__image">
    <Image
      src={images[imagePath]()}
      alt={altText}
    />
    <div class="speaker-card__bottom">
      <div class="speaker">
        <h4 class="speaker__name">{name}</h4>
        <p class="speaker__description">{description}</p>
      </div>
      <div class="divider"></div>
      <p class="talk-title">{talkTitle}</p>
    </div>
  </div>
</div>

<style lang="scss">
  .speaker-card {
    background: var(--color-neutral-800);
    border: 1px solid var(--color-neutral-600);
    display: flex;
    flex-direction: column;

    &__image {
      img {
        height: auto;
      }
    }

    &__bottom {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding: var(--space-sm);
    }

    .divider {
      background: var(--color-neutral-600);
      height: 1px;
    }

    .speaker {
      isplay: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>

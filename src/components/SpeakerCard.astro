---
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import bgSvg from "../assets/images/pattern-avatar-bg.svg";

interface Props {
  image: ImageMetadata;
  altText: string;
  name: string;
  description: string;
  bgColor: string;
}

const { image, altText, name, description, bgColor } = Astro.props;

const talks = (await getCollection("talks")).filter(
  (talk) =>
    talk.data.speaker ==
    name
      .toLowerCase()
      .replace(/[^a-zA-Z0-9ö ]/g, "")
      .replace(" ", "-"),
);
---

<div class="speaker-card">
  <div class:list={["speaker-card__image", bgColor]}>
    <Image
      src={image}
      alt={altText}
    />
  </div>
  <div class="speaker-card__bottom">
    <div class="speaker">
      <h3 class="speaker__name">{name}</h3>
      <p class="speaker__description">{description}</p>
    </div>
    <div class="divider"></div>
    <p class="talk-title">{talks.map((t) => t.data.title)}</p>
  </div>
</div>

<style lang="scss" define:vars={{ svgUrl: `url("${bgSvg.src}")` }}>
  .speaker-card {
    background: var(--color-neutral-800);
    border: 1px solid var(--color-neutral-600);
    display: flex;
    flex-direction: column;
    height: stretch;

    &:hover {
      border-color: var(--color-neutral-100);
      box-shadow: 4px 4px 0 0 var(--color-neutral-100);
      cursor: pointer;
    }

    &:active {
      border: 1px dashed var(--color-green-200);
      box-shadow: 4px 4px 0 0 var(--color-green-200);
    }

    &__image {
      background-image: var(--svgUrl);
      background-size: contain;
      background-position: center;
      img {
        height: auto;
      }
    }

    &__bottom {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      height: stretch;
      padding: var(--space-sm);
    }

    .divider {
      background: var(--color-neutral-600);
      height: 1px;
    }

    .speaker {
      isplay: flex;
      flex-direction: column;
      gap: 0.25rem;
      height: stretch;

      &__name {
        color: var(--color-neutral-100);
        text-transform: lowercase;
      }

      &__description {
        @include type-body-sm;
        font-weight: 500;
      }
    }

    .talk-title {
      @include type-body-sm;
      color: var(--color-green-200);
      font-weight: 500;
      text-transform: uppercase;
    }
  }
</style>

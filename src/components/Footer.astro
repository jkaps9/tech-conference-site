---
import Social from "./Social.astro";
import Logo from "./Logo.astro";
import navData from "../data/navData.json";
import { BUSINESS } from "@data/client";
---

<footer>
  <div class="container">
    <div class="footer__main-content">
      <div class="footer__logo">
        <Logo />
        <p>
          A three-day conference for engineers who build the interfaces humans
          use every day.
        </p>
      </div>
      <div class="footer__links">
        <nav class="footer__nav">
          <h2 class="list-header">// Navigate</h2>
          <ul class="nav-list">
            {
              navData.map((item) => (
                <li
                  class:list={[
                    "nav-list__item",
                    { "nav-links__dropdown": item.children?.length > 0 },
                  ]}
                >
                  <a href={item.url}>{item.key}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="footer__tracks">
          <h2 class="list-header">// Tracks</h2>
          <ul class="track-list">
            <li class="track-list__item"><a href="">Frontend</a></li>
            <li class="track-list__item"><a href="">Performance</a></li>
            <li class="track-list__item"><a href="">Accessibility</a></li>
            <li class="track-list__item"><a href="">Tooling</a></li>
          </ul>
        </div>
        <div class="footer__venue">
          <h2 class="list-header">// Venue</h2>
          <ul class="contact-list">
            <li>
              <p>
                {BUSINESS.address.lineOne}
              </p>
              <p>
                {BUSINESS.address.city}, {BUSINESS.address.state}
              </p>
              <p>Nov 15-17, 2026</p>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer__bottom row">
      <p class="footer_copyright">
        &copy;2026 {BUSINESS.name}. All rights reserved.
      </p>
      <div class="footer__bottom__links">
        <a href="#main">Back to top ↑</a>
      </div>
    </div>
  </div>
</footer>

<style lang="scss">
  footer {
    padding: 1rem 0 2rem; /* Same as header */

    p,
    a {
      @include type-body-sm;
    }

    .list-header {
      @include type-body-sm;
      font-weight: 500;
      margin-bottom: 1rem;
      text-transform: uppercase;
    }

    .container {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .footer__main-content {
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 0.5344rem + 3.0534vw, 2rem);
    }

    .footer__links {
      display: flex;
      flex-direction: column;
      gap: clamp(2rem, 0.9437rem + 4.507vw, 5rem);
    }

    .footer__logo {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
      p {
        max-width: 400px;
      }
    }

    .nav-list,
    .track-list,
    .contact-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      list-style-type: none;
      padding: 0;
    }

    .footer__bottom.row {
      align-items: flex-start;
      border-top: 1px solid var(--color-neutral-600);
      flex-direction: column;
      gap: 0.75rem;
      padding: clamp(1.25rem, 1.162rem + 0.3756vw, 1.5rem) 0;
      text-transform: uppercase;
      width: stretch;
    }
  }

  @media (min-width: 48rem) {
    footer {
      padding: 2rem 0 1rem;
      .footer__links {
        align-items: start;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        justify-items: start;
      }

      .footer__nav {
        text-align: start;
      }

      .footer__venue {
        text-align: start;
      }

      .footer__bottom.row {
        flex-direction: row;
        grid-column: 1 / -1;
      }
    }
  }

  @media (min-width: 64rem) {
    footer {
      .footer__main-content {
        flex-direction: row;
      }

      .footer__logo {
        margin-right: auto;
      }
    }
  }
</style>

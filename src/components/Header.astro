---
import navData from "../data/navData.json";
import Logo from "./Logo.astro";

const { PageTitle } = Astro.props;
---

<header>
  <div class="container">
    <nav
      class="navbar"
      aria-label="main navigation"
    >
      <Logo />
      <div class="nav-list-wrapper">
        <ul
          id="main-menu"
          class="nav-list"
        >
          {
            navData.map((item) => (
              <li class:list="nav-list__item">
                <a
                  href={item.url}
                  class:list={[
                    "btn btn--nav",
                    {
                      active:
                        PageTitle?.toLowerCase() === item.key.toLowerCase(),
                    },
                  ]}
                >
                  {item.key}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <!-- <ThemeIcon /> -->
      <button
        type="button"
        aria-expanded="false"
        aria-controls="main-menu"
        class="nav-toggle btn btn--nav"
        aria-label="Open navigation menu"
      >
        <span
          aria-hidden="true"
          class="line1"
        >
        </span>
        <span
          aria-hidden="true"
          class="line2"
        >
        </span>
        <span
          aria-hidden="true"
          class="line3"
        >
        </span>
      </button>
    </nav>
  </div>
</header>

<style lang="scss">
  header {
    position: relative;
    .container {
      border-bottom: 1px solid var(--color-neutral-600);
      padding: clamp(0.75rem, 0.5739rem + 0.7512vw, 1.25rem) 0;
      position: static;
    }
  }

  .navbar {
    align-items: center;
    display: flex;
    gap: 2rem;

    :global(.logo) {
      margin-right: auto;
    }
  }

  .nav-toggle {
    align-items: center;
    background-color: transparent;
    border: 1px solid var(--color-text);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    justify-content: center;
    min-height: 40px;
    min-width: 40px;
    padding: 10px 0;
    /* position: relative; */
    z-index: 1001;

    .line1,
    .line2,
    .line3 {
      --width: 1.25rem;
      width: var(--width);
      height: 2px;
      background-color: var(--color-text);
    }

    .line1,
    .line3 {
      transform: rotateZ(0);
      transition:
        transform 0.3s ease-in,
        opacity 0.3s;
    }
  }

  .nav-list {
    list-style-type: none;
    padding: 0;
  }

  .nav-list__item a {
    color: var(--color-header);
    font-size: 1.2rem;
    font-weight: 400;
    text-decoration: none;
    transition: color 0.3s ease;

    &:hover {
      color: var(--color-body-text);
    }
  }

  @media (max-width: 47.99rem) {
    body {
      overflow-x: hidden;
    }

    header {
      box-sizing: border-box;
      padding: 0;
      z-index: 10000;
      &::before {
        /* black blurred overlay */
        content: "";
        backdrop-filter: blur(10px);
        background: rgba(0, 0, 0, 0.6);
        display: block;
        height: 100vh;
        opacity: 0;
        position: absolute;
        right: 0;
        top: 100%;
        transition:
          width 0.5s,
          opacity 0.3s;
        width: 0%;
        z-index: -11;
      }
    }
    .container {
      box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 12px;
    }
    .nav-list-wrapper {
      align-items: stretch;
      bottom: 0;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      min-height: 100vh;
      margin-left: 0 auto;
      padding: var(--space-md) var(--space-sm);
      position: absolute;
      right: 0;
      top: 100%;
      transform: translateX(100%);
      transition: transform 0.3s ease-in;
      visibility: hidden;
      width: stretch;
      z-index: -1;
    }

    .nav-list {
      align-items: stretch;
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);

      a {
        width: stretch;
      }
    }

    body.navbar:has(.nav-toggle[aria-expanded="true"]) {
      overflow: hidden;
    }

    header:has(.nav-toggle[aria-expanded="true"]) {
      &::before {
        opacity: 1;
        width: 100%;
      }
    }

    .navbar:has(.nav-toggle[aria-expanded="true"]) {
      .nav-list-wrapper {
        transform: translateX(0);
        visibility: visible;
      }
      .nav-toggle {
        .line1 {
          transform: translateY(calc(var(--width) * 0.3)) rotateZ(45deg);
        }

        .line2 {
          opacity: 0;
        }

        .line3 {
          transform: translateY(calc(var(--width) * -0.3)) rotateZ(-45deg);
        }
      }
    }
  }

  @media (min-width: 48rem) {
    header {
      box-shadow: 0 8px 6px -8px rgba(0, 0, 0, 0.1);
    }

    .nav-list {
      background: none;
      display: flex;
      flex-direction: row;
      gap: var(--space-sm);
      position: static;
      width: auto;
    }

    .nav-toggle {
      display: none;
    }

    .nav-list-wrapper {
      align-items: center;
      display: flex;
      gap: 6em;
    }
  }
</style>

---
import { getCollection } from "astro:content";

const tracks = await getCollection("tracks");

const trackList = tracks.filter((t) => t.data.name !== "Keynote");
---

<section class="tracks">
  <div class="container">
    <h2 class="list-header">// Tracks</h2>
    <ul class="track-list">
      {
        trackList.map((track) => (
          <li class="track-list__item">
            <h3 class:list={["track__title", `text-${track.data.color}`]}>
              {track.data.name}
            </h3>
            <p class="track__description">{track.data.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="scss">
  .track-list {
    display: grid;
    gap: clamp(var(--space-sm), 1.338rem + -0.3756vw, var(--space-md));
    padding: 0;

    @include bp(md) {
      grid-template-columns: repeat(2, 1fr);
    }

    @include bp(xl) {
      grid-template-columns: repeat(4, 1fr);
    }

    &__item {
      background: var(--color-neutral-900);
      border: 1px solid var(--color-neutral-100);
      box-shadow: 2px 2px 0 0 var(--color-neutral-100);
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
      padding: var(--space-sm) var(--space-md);
      &:hover {
        cursor: pointer;
      }
      &:active {
        border: 1px dashed var(--color-green-200);
        box-shadow: 4px 4px 0 0 var(--color-green-200);
      }
    }
  }
  .track {
    &__title {
      text-transform: lowercase;
    }

    &__description {
      @include type-body-sm;
      font-weight: 500;
      max-width: 27ch;
      text-transform: uppercase;
    }
  }
</style>
